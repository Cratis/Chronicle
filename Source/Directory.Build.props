
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Project="$(MSBuildThisFileDirectory)../Directory.Build.props" />

    <PropertyGroup>
        <!-- CI stamps <next minor>-ci-<run> (#5353); a global -p:Version (publish) always wins; local builds stay 1.0.0, which the kernel treats as unknown. -->
        <Version>1.0.0</Version>
        <Version Condition="'$(CRATIS_CHRONICLE_BUILD_VERSION)' != ''">$(CRATIS_CHRONICLE_BUILD_VERSION)</Version>
        <Copyright>Copyright Cratis</Copyright>
        <Authors>Cratis</Authors>
        <Company>Cratis</Company>
        <DebugType>portable</DebugType>
        <PackageIcon>logo.png</PackageIcon>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <RepositoryUrl>https://github.com/Cratis/Chronicle</RepositoryUrl>
        <PackageProjectUrl>https://www.cratis.io/chronicle/</PackageProjectUrl>

        <!-- Default NuGet metadata - individual projects can override -->
        <Description>Cratis Chronicle - an open-source (MIT) event-sourcing database and processing runtime with an Orleans-based kernel, pluggable storage (MongoDB default; PostgreSQL, SQL Server, SQLite, in-memory), and language-agnostic gRPC contracts.</Description>
        <PackageTags>event-sourcing;event-store;cqrs;orleans;dotnet;grpc;mongodb;postgresql;sqlserver;sqlite</PackageTags>

        <GenerateAssemblyTitleAttribute>true</GenerateAssemblyTitleAttribute>
        <GenerateAssemblyDescriptionAttribute>true</GenerateAssemblyDescriptionAttribute>

        <!-- Versioning -->
        <!-- AssemblyVersion and FileVersion must be numeric (major.minor.patch.revision) -->
        <!-- InformationalVersion can include SemVer prerelease and metadata -->
        <InformationalVersion Condition="'$(SourceRevisionId)' != ''">$(Version)+$(SourceRevisionId)</InformationalVersion>
        <InformationalVersion Condition="'$(SourceRevisionId)' == ''">$(Version)</InformationalVersion>

        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsTestProject>false</IsTestProject>

        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <IsPackable>true</IsPackable>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>

        <RuntimeIdentifiers>linux-arm64;linux-x64</RuntimeIdentifiers>

        <NuGetAuditMode>all</NuGetAuditMode>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Debug'">
        <Configuration>Debug</Configuration>
        <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
        <MSBuildTreatWarningsAsErrors>False</MSBuildTreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>False</CodeAnalysisTreatWarningsAsErrors>
        <StyleCopTreatErrorsAsWarnings>True</StyleCopTreatErrorsAsWarnings>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <Configuration>Release</Configuration>
        <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
        <MSBuildTreatWarningsAsErrors>True</MSBuildTreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>True</CodeAnalysisTreatWarningsAsErrors>
        <StyleCopTreatErrorsAsWarnings>False</StyleCopTreatErrorsAsWarnings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
        <PackageReference Include="Cratis.Fundamentals" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)/../README.md" Pack="true" PackagePath="/" />
        <None Include="$(MSBuildThisFileDirectory)/../logo.png" Pack="true" PackagePath="/" />
        <Compile Include="$(MSBuildThisFileDirectory)/GlobalAssemblyInfo.cs" />
    </ItemGroup>

    <PropertyGroup Condition="'$(IsTestProject)'=='true'">
        <IsPackable>false</IsPackable>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsTestProject)'=='true'">
        <PackageReference Include="coverlet.collector" />
        <PackageReference Include="NSubstitute" />
        <!-- NSubstitute reaches Castle.Core transitively, and a PackageVersion only binds a direct PackageReference -
             so the Castle.Core pin in Directory.Packages.props is inert without this line and NuGet floats to whatever
             the graph offers. Castle.Core 5.2.1 cannot proxy an interface carrying a default implementation: mapping
             the member yields a null declaring type and the substitute throws on first access. Chronicle's client
             artifact interfaces use default interface members, so the difference is not theoretical.
             NoWarn="NU1605" lets this one deliberate downgrade through; every other downgrade still fails restore. -->
        <PackageReference Include="Castle.Core" NoWarn="NU1605" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <Compile Include="$(MSBuildThisFileDirectory)/GlobalUsings.Specs.cs" />
    </ItemGroup>

    <PropertyGroup>
        <!-- CRSPECEXP01: the type-discovery generator emits typeof() for Specifications' experimental resource types (see the 5.0 upgrade guide).
             Applied to every project because IsTestProject is only set after this file evaluates.
             xUnit1051: cancellation-token propagation in existing specs is adopted incrementally, not as part of this migration. -->
        <NoWarn>$(NoWarn);CRSPECEXP01;xUnit1051</NoWarn>
        <!-- Keep the original display names; the shared per-class lifecycle stays on. -->
        <CratisSpecificationsReadableNames>false</CratisSpecificationsReadableNames>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsTestProject)'=='true' and '$(UseXunitV2)'!='true'">
        <PackageReference Include="Cratis.Specifications.XUnit.v3" />
        <PackageReference Include="xunit.v3.mtp-off" />
    </ItemGroup>

    <ItemGroup Condition="'$(IsTestProject)'=='true' and '$(UseXunitV2)'=='true'">
        <PackageReference Include="Cratis.Specifications.XUnit" />
        <PackageReference Include="xunit" />
    </ItemGroup>
</Project>
