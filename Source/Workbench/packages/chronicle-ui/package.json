{
    "name": "@cratis/chronicle-ui",
    "version": "0.0.0",
    "description": "Reusable Cratis Chronicle Workbench UI for React hosts: the Workbench card and a live event store names hook.",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Cratis/Chronicle.git",
        "directory": "Source/Workbench/packages/chronicle-ui"
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist",
        "!dist/styles.js",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "types": "./dist/types/src/index.d.ts",
            "import": "./dist/index.js"
        },
        "./event-stores": {
            "types": "./dist/types/src/event-stores/index.d.ts",
            "import": "./dist/event-stores.js"
        },
        "./styles.css": "./dist/styles.css",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
        "build:watch": "vite build --watch",
        "check:consumers": "node ./check-consumers.mjs"
    },
    "peerDependencies": {
        "@cratis/arc": "^23.21.0",
        "@cratis/arc.react": "^23.21.0",
        "@cratis/components": "^4.63.0",
        "@cratis/fundamentals": "^7.34.3",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "reflect-metadata": "0.2.2"
    },
    "devDependencies": {
        "@cratis/arc": "^23.21.0",
        "@cratis/arc.react": "^23.21.0",
        "@cratis/arc.vite": "^23.21.0",
        "@cratis/components": "^4.63.0",
        "@cratis/fundamentals": "^7.34.3",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "reflect-metadata": "0.2.2",
        "typescript": "7.0.2",
        "vite": "8.3.8"
    }
}
