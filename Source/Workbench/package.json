        "eslint-plugin-react-refresh": "0.5.5",
        "globals": "17.11.0",
        "hash-files": "1.1.1",
        "mocha": "11.8.0",
        "prettier": "3.9.6",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-router-dom": "7.18.2",
        "sinon": "22.1.0",
        "sinon-chai": "4.0.1",
        "storybook": "^10.5.10",
        "tailwindcss": "4.3.3",
        "ts-node": "10.9.2",
        "tsconfig-paths": "4.2.0",
        "typescript": "7.0.2",
        "typescript-eslint": "8.68.0",
        "typescript-for-eslint": "npm:typescript@6.0.3",
        "vite": "8.2.2",
