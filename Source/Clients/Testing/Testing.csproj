<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <TargetFrameworks></TargetFrameworks>
        <AssemblyName>Cratis.Chronicle.Testing</AssemblyName>
        <RootNamespace>Cratis.Chronicle.Testing</RootNamespace>
        <Description>Testing helpers for Cratis Chronicle - the open-source (MIT) event-sourcing database and runtime. In-process kernel and in-memory storage for testing event-sourced applications.</Description>
        <PackageTags>event-sourcing;event-store;cqrs;testing;dotnet;chronicle</PackageTags>
        <IsTestProject>false</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Cratis.Chronicle.Testing.Specs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../DotNET/DotNET.csproj" />
        <ProjectReference Include="../Connections/Connections.csproj" />
        <ProjectReference Include="../../Infrastructure/Infrastructure.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="../../Kernel/Contracts/Contracts.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="../../Kernel/Concepts/Concepts.csproj">
            <Aliases>KernelConcepts</Aliases>
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="../../Kernel/Compatibility/Compatibility.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="../../Kernel/Core/Core.csproj">
            <Aliases>KernelCore</Aliases>
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <!-- The Cratis.Chronicle.Services.* service implementations these scenarios wrap in-memory now live
             here, not in Core - see Source/Kernel/Grpc/Grpc.csproj. -->
        <ProjectReference Include="../../Kernel/Grpc/Grpc.csproj">
            <Aliases>KernelGrpc</Aliases>
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="../../Kernel/Storage/Storage.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="../../Kernel/Storage.InMemory/Storage.InMemory.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup>
        <!-- The embedded Core and gRPC assemblies dispatch through Arc and register Arc query
             metadata at module load. Keep Arc as a declared dependency so its version unifies
             with the consumer's Arc packages instead of embedding a second copy. -->
        <PackageReference Include="Cratis.Arc" />
        <PackageReference Include="Cratis.Arc.Core" />
        <!-- The embedded Core migration engine evaluates JMESPath for registered migrations. -->
        <PackageReference Include="JsonCons.JmesPath" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <!-- The embedded kernel's job system now comes from these packages; without the reference the
             Arc-generated module initializer cannot bind them and every scenario fails at startup. -->
        <PackageReference Include="Cratis.Orleans" />
        <PackageReference Include="Cratis.Orleans.Storage" />
        <PackageReference Include="Cratis.Orleans.Storage.MongoDB" />
        <!-- Embedded kernel assemblies are compiled against these packages. Declare them directly so
             consumers cannot resolve lower transitive versions than those assemblies require. -->
        <PackageReference Include="Cratis.Metrics.Roslyn" />
        <PackageReference Include="DnsClient" />
        <PackageReference Include="FluentValidation" />
        <PackageReference Include="Grpc.Net.Client" />
        <PackageReference Include="Microsoft.AspNetCore.Cryptography.KeyDerivation" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
        <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
        <PackageReference Include="Microsoft.Extensions.Resilience" />
        <PackageReference Include="Microsoft.Extensions.Telemetry.Abstractions" />
        <PackageReference Include="OneOf" />
        <PackageReference Include="OpenTelemetry" />
        <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Instrumentation.GrpcNetClient" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
        <PackageReference Include="protobuf-net" />
        <PackageReference Include="protobuf-net.Grpc" />
        <PackageReference Include="protobuf-net.Grpc.Reflection" />
        <PackageReference Include="protobuf-net.Reflection" />
        <PackageReference Include="System.Reactive" />
        <!-- <PackageReference Include="Microsoft.Orleans.BroadcastChannel" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.Orleans.Sdk" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.Orleans.Server" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.Orleans.Reminders" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.Orleans.Streaming" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.Orleans.Serialization.SystemTextJson" PrivateAssets="all"/> -->
    </ItemGroup>

    <!-- Pack Orleans, the kernel's Screenplay compiler and Roslyn runtime assemblies into lib/ so they are
         available without nuspec dependencies. Core's projection-to-client-code generation needs the Roslyn
         C# syntax model (CSharpSyntaxRewriter/CSharpSyntaxVisitor) at runtime, so any consumer constructing a
         scenario needs it too. Cratis.Screenplay depends on sibling Cratis.Screenplay.* packages (Matching,
         Contexts); they travel with it, or type discovery fails to load them at the first scenario. -->
    <PropertyGroup>
        <PrivatePackageRuntimeAssemblyRegex>^(Orleans\..*|Cratis\.Screenplay(\..+)?|Microsoft\.CodeAnalysis(\.CSharp)?)\.dll$</PrivatePackageRuntimeAssemblyRegex>
    </PropertyGroup>

</Project>
