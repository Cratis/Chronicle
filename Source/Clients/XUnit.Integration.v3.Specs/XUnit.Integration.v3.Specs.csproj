<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <TargetFrameworks></TargetFrameworks>
        <OutputType>Exe</OutputType>
        <AssemblyName>Cratis.Chronicle.XUnit.Integration.v3.Specs</AssemblyName>
        <RootNamespace>Cratis.Chronicle.XUnit.Integration</RootNamespace>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../XUnit.Integration.v3/XUnit.Integration.v3.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="../XUnit.Integration.Specs/for_ChronicleClientFixture/**/*.cs" LinkBase="for_ChronicleClientFixture" />
        <Compile Include="../XUnit.Integration.Specs/for_ChronicleOrleansFixture/**/*.cs" LinkBase="for_ChronicleOrleansFixture" />
        <Compile Include="../XUnit.Integration.Specs/for_EventAppendCollection/**/*.cs" LinkBase="for_EventAppendCollection" />
        <Compile Include="../XUnit.Integration.Specs/for_MongoDBContextStorage/**/*.cs" LinkBase="for_MongoDBContextStorage" />
        <Compile Include="../XUnit.Integration.Specs/Packaging/for_the_embedded_kernel_closure/*.cs" LinkBase="Packaging/for_the_embedded_kernel_closure" />
        <PackageReference Remove="xunit" />
        <PackageReference Remove="Cratis.Specifications.XUnit" />
        <!-- Microsoft.NET.Test.Sdk, xunit.runner.visualstudio and NSubstitute come from Source/Directory.Build.props. -->
        <PackageReference Include="xunit.v3.mtp-off" />
        <PackageReference Include="Cratis.Specifications.XUnit.v3" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="NSubstitute" />
        <Using Include="Cratis.Specifications" />
        <Using Include="Xunit" />
    </ItemGroup>
</Project>
