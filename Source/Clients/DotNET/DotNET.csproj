<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Chronicle</AssemblyName>
        <RootNamespace>Cratis.Chronicle</RootNamespace>
        <Description>The .NET client SDK for Cratis Chronicle - the open-source (MIT) event-sourcing database and runtime. Typed events, projections, reducers, reactors, constraints, and read models over a gRPC boundary.</Description>
        <ContractsImplementationAssembly>Cratis.Chronicle.Contracts.Implementations</ContractsImplementationAssembly>
        <!-- The published package still targets net10.0. On net11.0, IDE0301 suggests collection expressions
             such as [] for FrozenDictionary<K,V>.Empty, which fail with CS0144 on the net10.0 target. -->
        <NoWarn>$(NoWarn);IDE0301</NoWarn>
        <!-- The serverless surface is public and [Experimental("CHRX0001")]; the library itself uses it. -->
        <NoWarn>$(NoWarn);CHRX0001</NoWarn>
    </PropertyGroup>

    <!-- Candidate-only instrumentation. The SDK's artifacts layout isolates the entire project graph,
         not merely this assembly. Never enable this in a package, image or release build. -->
    <PropertyGroup Condition="'$(EnableRollingDeliveryDiagnostics)' == 'true'">
        <DefineConstants>$(DefineConstants);CHRONICLE_ROLLING_DIAGNOSTICS</DefineConstants>
        <IsPackable>false</IsPackable>
        <IsPublishable>false</IsPublishable>
    </PropertyGroup>

    <Target Name="ValidateRollingDeliveryDiagnostics" BeforeTargets="PrepareForBuild;CoreCompile">
        <PropertyGroup Condition="'$(EnableRollingDeliveryDiagnostics)' == 'true' AND '$(ArtifactsPath)' != ''">
            <DiagnosticRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../..'))/</DiagnosticRepositoryRoot>
            <DiagnosticArtifactsRoot>$([System.IO.Path]::GetFullPath('$(ArtifactsPath)'))/</DiagnosticArtifactsRoot>
        </PropertyGroup>
        <Error Condition="'$(EnableRollingDeliveryDiagnostics)' != 'true' AND $([System.String]::Copy('$(DefineConstants)').Contains('CHRONICLE_ROLLING_DIAGNOSTICS'))"
               Text="Rolling delivery diagnostics require EnableRollingDeliveryDiagnostics and isolated artifacts output." />
        <Error Condition="'$(EnableRollingDeliveryDiagnostics)' == 'true' AND ('$(ArtifactsPath)' == '' OR '$(UseArtifactsOutput)' != 'true' OR !$([System.IO.Path]::IsPathFullyQualified('$(ArtifactsPath)')))"
               Text="Rolling delivery diagnostics require an absolute ArtifactsPath and UseArtifactsOutput=true." />
        <Error Condition="'$(EnableRollingDeliveryDiagnostics)' == 'true' AND !$([System.String]::Copy('$(ArtifactsPath)').EndsWith('/rolling-delivery-diagnostics'))"
               Text="Diagnostic ArtifactsPath must end in /rolling-delivery-diagnostics; do not reuse shipping outputs." />
        <Error Condition="'$(EnableRollingDeliveryDiagnostics)' == 'true' AND $([System.String]::Copy('$(DiagnosticArtifactsRoot)').StartsWith('$(DiagnosticRepositoryRoot)')) AND !$([System.String]::Copy('$(DiagnosticArtifactsRoot)').StartsWith('$(DiagnosticRepositoryRoot).ai-work/'))"
               Text="Diagnostic artifacts must be outside the checkout or under ignored .ai-work, never in shipping artifact inputs." />
        <Error Condition="'$(EnableRollingDeliveryDiagnostics)' == 'true' AND (!$([System.IO.Path]::GetFullPath('$(TargetPath)').StartsWith('$(DiagnosticArtifactsRoot)')) OR !$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)').StartsWith('$(DiagnosticArtifactsRoot)')))"
               Text="Diagnostic output and intermediate paths must remain inside the isolated ArtifactsPath." />
        <Error Condition="'$(EnableRollingDeliveryDiagnostics)' == 'true' AND ('$(IsPackaging)' == 'true' OR '$(GeneratePackageOnBuild)' == 'true')"
               Text="Rolling delivery diagnostics cannot be packaged." />
    </Target>

    <ItemGroup>
        <InternalsVisibleTo Include="Cratis.Chronicle.AspNetCore" />
        <InternalsVisibleTo Include="Cratis.Chronicle.Api" />
        <InternalsVisibleTo Include="Cratis.Chronicle.Specs" />
        <InternalsVisibleTo Include="Cratis.Chronicle.Orleans" />
        <InternalsVisibleTo Include="Cratis.Chronicle.InProcess" />
        <InternalsVisibleTo Include="Cratis.Chronicle.Testing" />
        <InternalsVisibleTo Include="Cratis.Chronicle.XUnit.Integration" />
        <InternalsVisibleTo Include="Cratis.Chronicle.XUnit.Integration.v3" />
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
        <InternalsVisibleTo Include="ProtoBuf.Grpc.Internal.Proxies" />
        <InternalsVisibleTo Include="System.Reflection.Emit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Connections/Connections.csproj"/>
        <ProjectReference Include="../../Kernel/Contracts/Contracts.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="../../Infrastructure/Infrastructure.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="../../Kernel/Concepts/Captures/*.cs" Link="Concepts/Captures/%(Filename)%(Extension)" />
        <Compile Include="../../Kernel/Concepts/Patterns/*.cs" Link="Concepts/Patterns/%(Filename)%(Extension)" />
    </ItemGroup>

    <Target Name="GrpcClients" BeforeTargets="Build" Inputs="$(TargetDir)Cratis.Chronicle.Contracts.dll;@(GrpcClientGeneratorAssembly)" Outputs="$(TargetDir)Cratis.Chronicle.Contracts.Implementations.dll" Condition=" '$(TargetFramework)' != '' AND '$(RuntimeIdentifier)' == '' AND '$(NoBuild)' != 'true' ">
        <Message Text="Generating gRPC clients" Importance="high" />
        <Exec Command="dotnet &quot;@(GrpcClientGeneratorAssembly)&quot; &quot;$(TargetDir)Cratis.Chronicle.Contracts.dll&quot; $(ContractsImplementationAssembly)" />
    </Target>

    <ItemGroup>
        <!-- Public package dependency for consumers: PrivateAssets deliberately omits "all" so
             Cratis.Chronicle.CodeAnalysis lands in the nuspec and a consumer actually receives the CHR
             analyzers.

             Chronicle does not run these analyzers over its own source. CHR0001 and CHR0002 ask whether a
             type carries [EventType], which cannot be answered about the open generic parameters the client's
             own plumbing is written in - they are questions about application code, asked of the library that
             defines the attribute. Making this assembly analyzer-clean is its own piece of work. -->
        <ProjectReference Include="../DotNET.CodeAnalysis.Package/DotNET.CodeAnalysis.Package.csproj"
                          PrivateAssets="compile;runtime" />
        <!-- Build the generator once through the MSBuild project graph. Nested dotnet run invocations raced
             while multi-target packaging copied runtime dependencies into the same tool directory. -->
        <ProjectReference Include="../../Tools/GrpcClients/GrpcClients.csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all"
                          OutputItemType="GrpcClientGeneratorAssembly"
                          SkipGetTargetFrameworkProperties="true"
                          GlobalPropertiesToRemove="TargetFramework;TargetFrameworks;RuntimeIdentifier;IsPackaging" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
        <PackageReference Include="protobuf-net.Grpc" />
        <PackageReference Include="Grpc.Net.Client" />
        <PackageReference Include="System.Reactive" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Cratis.Metrics.Roslyn" />
      <PackageReference Include="OpenTelemetry" />
        <PrivatePackageAssembly Include="$(ContractsImplementationAssembly)" />
    </ItemGroup>

    <!--
        Packaging fix: Cratis.Chronicle.Infrastructure.dll ships in lib/ because of the PrivateAssets=all
        ProjectReference above, but the SDK only emits Cratis.Chronicle.dll in ref/. Consumers that compile
        against the ref assembly fail with CS0012 when the compiler encounters types from Infrastructure
        (e.g. PropertyPath used on IReadModelPropertiesBuilder.Set). Including the dll in ref/ as well fixes
        this without changing the runtime behaviour.
    -->
    <Target Name="IncludeInfrastructureInRefFolder" BeforeTargets="_GetTfmSpecificContentForPackage">
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(TargetDir)Cratis.Chronicle.Infrastructure.dll"
                                    PackagePath="ref/$(TargetFramework)/" />
        </ItemGroup>
    </Target>
</Project>
