<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Chronicle.Testing.Specs</AssemblyName>
        <RootNamespace>Cratis.Chronicle.Testing</RootNamespace>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Testing/Testing.csproj" />
        <ProjectReference Include="../AspNetCore/AspNetCore.csproj" />
        <ProjectReference Include="../Connections/Connections.csproj" />
        <ProjectReference Include="../../Kernel/Contracts/Contracts.csproj" />
        <ProjectReference Include="../../Infrastructure/Infrastructure.csproj" />

        <!-- Kernel assemblies with aliases, to host the kernel in an application container the way the in-process
             integration fixtures do. Aliased so their namespaces do not collide with the client's. -->
        <ProjectReference Include="../../Kernel/Concepts/Concepts.csproj" Aliases="KernelConcepts" />
        <ProjectReference Include="../../Kernel/Compatibility/Compatibility.csproj" Aliases="KernelCompatibility" />
        <ProjectReference Include="../../Kernel/Storage/Storage.csproj" Aliases="KernelStorage" />
        <ProjectReference Include="../../Kernel/Core/Core.csproj" Aliases="KernelCore" />
        <ProjectReference Include="../../Kernel/Grpc/Grpc.csproj" Aliases="KernelGrpc" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.Arc" />
        <PackageReference Include="Cratis.Arc.Core" />
        <PackageReference Include="Cratis.Screenplay" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Microsoft.Extensions.Telemetry.Abstractions" />
        <PackageReference Include="Microsoft.Orleans.BroadcastChannel" />
        <PackageReference Include="Microsoft.Orleans.Core.Abstractions" />
        <PackageReference Include="Microsoft.Orleans.Sdk" />
        <PackageReference Include="Microsoft.Orleans.Serialization" />
        <PackageReference Include="Microsoft.Orleans.Serialization.SystemTextJson" />
        <PackageReference Include="Microsoft.Orleans.Server" />
        <PackageReference Include="Microsoft.Orleans.Streaming" />
        <PackageReference Include="Microsoft.Orleans.Reminders" />
    </ItemGroup>
</Project>
