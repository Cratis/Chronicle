<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Chronicle.Specs</AssemblyName>
        <RootNamespace>Cratis.Chronicle</RootNamespace>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);MA0182</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../DotNET/DotNET.csproj" />
        <ProjectReference Include="../Connections/Connections.csproj" />
        <ProjectReference Include="../../Kernel/Contracts/Contracts.csproj" />

        <!-- For the specification that holds the client's mirrored concepts to the kernel's. Aliased so the two
             copies of a concept can be named in the same file without the namespaces colliding. -->
        <ProjectReference Include="../../Kernel/Concepts/Concepts.csproj">
            <Aliases>KernelConcepts</Aliases>
        </ProjectReference>
        <ProjectReference Include="../../Infrastructure/Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.Arc" />
        <PackageReference Include="Cratis.Arc.Core" />
        <PackageReference Include="FluentValidation" />
        <PackageReference Include="protobuf-net.Grpc" />
        <PackageReference Include="Testcontainers" />
        <!-- Pulls Testcontainers' vulnerable SSH.NET forward — see Directory.Packages.props. -->
        <PackageReference Include="SSH.NET" />
    </ItemGroup>

    <!-- Reuse the exact CoreDNS zone the Composition sample serves, so the +srv integration
         spec resolves against the same DNS records the scale-out story runs against. -->
    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)../../../Samples/Composition/dns/Corefile" Link="dns/Corefile" CopyToOutputDirectory="PreserveNewest" />
        <None Include="$(MSBuildThisFileDirectory)../../../Samples/Composition/dns/chronicle.local.zone" Link="dns/chronicle.local.zone" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
