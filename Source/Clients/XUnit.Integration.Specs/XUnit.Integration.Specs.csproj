<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Chronicle.XUnit.Integration.Specs</AssemblyName>
        <RootNamespace>Cratis.Chronicle.XUnit.Integration</RootNamespace>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!-- The v3 harness compiles the shared harness sources, so the specs cover that logic once, on xUnit v3. -->
        <ProjectReference Include="../XUnit.Integration.v3/XUnit.Integration.v3.csproj" />
        <ProjectReference Include="../../Infrastructure/Infrastructure.csproj" />
        <ProjectReference Include="../../Kernel/Core/Core.csproj">
            <Aliases>KernelCore</Aliases>
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="../../Kernel/Grpc/Grpc.csproj">
            <Aliases>KernelGrpc</Aliases>
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
    </ItemGroup>
</Project>
