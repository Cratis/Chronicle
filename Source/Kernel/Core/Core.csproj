<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Chronicle.Core</AssemblyName>
        <RootNamespace>Cratis.Chronicle</RootNamespace>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\GeneratedFiles</CompilerGeneratedFilesOutputPath>
        <NoWarn>$(NoWarn);ORLEANS0010;CS8618;MA0182</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Cratis.Chronicle.Core.Specs" />
        <InternalsVisibleTo Include="Cratis.Chronicle.Grains" />
        <InternalsVisibleTo Include="Cratis.Chronicle.Grains.Interfaces" />
        <InternalsVisibleTo Include="Cratis.Chronicle.Server" />
        <InternalsVisibleTo Include="Cratis.Chronicle.InProcess" />
        <InternalsVisibleTo Include="Cratis.Chronicle.XUnit.Integration" />
        <InternalsVisibleTo Include="Cratis.Chronicle.Testing" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../Infrastructure/Infrastructure.csproj" />
        <ProjectReference Include="../Compatibility/Compatibility.csproj" />
        <ProjectReference Include="../Contracts/Contracts.csproj" />
        <ProjectReference Include="../Storage/Storage.csproj" />
        <ProjectReference Include="../Concepts/Concepts.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="../../Clients/Connections/Connections.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
    </ItemGroup>

    <!-- Services that are not derived from Arc artifacts yet. The generator leaves both the contract and the
         implementation alone for these, so a hand-written contract that has drifted from what Core can produce
         is not silently replaced by a smaller one. Observers is the remaining case: Contracts/Observation
         /IObservers.cs carries five methods Core has no artifacts for, and its existing rpcs are named
         differently from what the artifacts would produce. Removing it from this list is what Step 3 of the
         Observation migration means. -->
    <PropertyGroup>
        <NonDerivedGrpcServices>Observers</NonDerivedGrpcServices>
    </PropertyGroup>

    <!-- Generates the gRPC contracts under ../Contracts from this project's Arc artifacts, the classes that
         implement them under ./Services, and the registrations for those in ../Server. Gated separately from
         the TypeScript ProxyGenerator below - see the property group further down for why each is held back.
         Until this is ungated, the contracts for converted services are checked in and can drift. -->
    <Target Name="GenerateGrpcContracts" AfterTargets="Build" Condition=" '$(TargetFramework)' != '' AND '$(RuntimeIdentifier)' == '' AND '$(DisableGrpcContractGeneration)' != 'true' ">
        <Message Text="Generating gRPC contracts and service implementations from Arc artifacts" Importance="high" />
        <Exec Command="dotnet run -- &quot;$(TargetPath)&quot; &quot;$(MSBuildThisFileDirectory)../Contracts&quot; --skip-namespaces 2 --base-namespace Cratis.Chronicle.Contracts --implementations &quot;$(MSBuildThisFileDirectory)Services&quot; --implementations-namespace Cratis.Chronicle.Services --registrations &quot;$(MSBuildThisFileDirectory)../Server/GeneratedGrpcServices.cs&quot; --registrations-namespace Cratis.Chronicle.Server --exclude $(NonDerivedGrpcServices)" WorkingDirectory="$(MSBuildThisFileDirectory)../../../Source/Tools/GrpcCodeGenerator" />
    </Target>

    <PropertyGroup>
        <!--
            Two generators read this project and they are not ready at the same time, so they have separate
            switches. They used to share DisableProxyGenerator, which meant turning on TypeScript proxies also
            re-ran gRPC contract generation and silently dropped contract methods.

            GenerateGrpcContracts (above) is held back because Contracts/Observation/IObservers.cs carries five
            methods Core cannot produce yet - GetObserverInformation, GetConnectedClientsForObserver,
            WaitForCompletion, GetReplayableObserversForEventTypes and ClearObserverQuarantine. Regenerating drops
            them. Converting those to Core artifacts is what lifts this.

            The Arc ProxyGenerator is held back because most of the Web API surface still lives in
            Source/Clients/Api, which generates the Workbench's proxies today. See API-MIGRATION.md.

            Running either by hand needs CopyLocalLockFileAssemblies=true: the ProxyGenerator resolves referenced
            assemblies from the output directory, and a library project does not copy its NuGet runtime assets
            there, so Orleans.Serialization is missing and generation aborts.
        -->
        <DisableGrpcContractGeneration Condition="'$(DisableGrpcContractGeneration)' == ''">true</DisableGrpcContractGeneration>
        <DisableProxyGenerator Condition="'$(DisableProxyGenerator)' == ''">false</DisableProxyGenerator>

        <!-- The ProxyGenerator resolves referenced assemblies from the output directory, and a library project
             does not copy its NuGet runtime assets there. Without this, Orleans.Serialization cannot be resolved
             and generation aborts the build. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <PropertyGroup Condition="'$(DisableProxyGenerator)' != 'true'">
        <CratisProxiesOutputPath>$(MSBuildThisFileDirectory)../../Workbench/Features</CratisProxiesOutputPath>
        <CratisProxiesSegmentsToSkip>2</CratisProxiesSegmentsToSkip>
        <CratisProxiesSkipOutputDeletion>true</CratisProxiesSkipOutputDeletion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(DisableProxyGenerator)' != 'true' and $([System.IO.Path]::IsPathRooted('$(OutputPath)'))">
        <CratisProxiesOutputPath></CratisProxiesOutputPath>
    </PropertyGroup>

    <ItemGroup Condition="'$(DisableProxyGenerator)' != 'true'">
        <PackageReference Include="Cratis.Arc.ProxyGenerator.Build" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.Arc.Core" />
        <PackageReference Include="Cratis.Metrics.Roslyn" />
        <PackageReference Include="Cratis.Screenplay" />
        <PackageReference Include="Cratis.Arc" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
        <PackageReference Include="Microsoft.Extensions.Resilience" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
        <PackageReference Include="Microsoft.Extensions.Telemetry.Abstractions" />
        <PackageReference Include="Microsoft.Orleans.BroadcastChannel" />
        <PackageReference Include="Microsoft.Orleans.Sdk" />
        <PackageReference Include="Microsoft.Orleans.Server" />
        <PackageReference Include="Microsoft.Orleans.Reminders" />
        <PackageReference Include="Microsoft.Orleans.Streaming" />
        <PackageReference Include="Microsoft.Orleans.Serialization.SystemTextJson" />
        <PackageReference Include="JsonCons.JmesPath" />
        <PackageReference Include="OpenTelemetry" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Instrumentation.GrpcNetClient" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
        <PackageReference Include="System.Reactive" />
    </ItemGroup>
</Project>
