// Screenplay documentation: Documentation/screenplay/projections/property-mapping.md

module Conformance
  feature Cases
    slice StateView Case
      event ItemAdded
        name String
        count Int
      readmodel Summary
        summaryId String
        name String
        count Int
      query SummaryById => Summary?
        by summaryId String
      projection Summaries => Summary
        no automap
        from ItemAdded
          set once name = name
          set once count = count
