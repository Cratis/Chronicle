// add and subtract by an event property
// Screenplay documentation: Documentation/screenplay/projections/arithmetic.md

module Conformance
  feature Cases
    slice StateView Case
      event ItemAdded
        itemId String
        amount Decimal
        count Int
      event ItemRemoved
        itemId String
        amount Decimal
      readmodel Summary
        summaryId String
        items Int
        total Decimal
        count Int
      query SummaryById => Summary?
        by summaryId String
      projection Summaries => Summary
        no automap
        from ItemAdded
          add total by amount
        from ItemRemoved
          subtract total by amount
