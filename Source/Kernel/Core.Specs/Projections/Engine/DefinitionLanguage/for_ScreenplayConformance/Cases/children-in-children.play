// A child collection inside a child collection
// Screenplay documentation: Documentation/screenplay/projections/children.mdx

type OrderLine
  lineNumber Int
  sku String
type LineGroup
  groupId String
  lines OrderLine[]
module Conformance
  feature Cases
    slice StateView Case
      event GroupAdded
        orderId String
        groupId String
      event LineAdded
        groupId String
        lineNumber Int
        sku String
      readmodel OrderView
        orderId String
        groups LineGroup[]
      query OrderViewById => OrderView?
        by orderId String
      projection Orders => OrderView
        no automap
        children groups identified by groupId
          from GroupAdded key groupId
            parent orderId
          children lines identified by lineNumber
            from LineAdded key lineNumber
              parent groupId
              sku = sku
