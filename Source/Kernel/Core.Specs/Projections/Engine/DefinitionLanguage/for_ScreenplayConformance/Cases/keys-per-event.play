// from A, B, C with a key per event is one transition per event sharing the mappings
// Screenplay documentation: Documentation/screenplay/projections/keys.md

module Conformance
  feature Cases
    slice StateView Case
      event OrderPlaced
        orderId String
        label String
        region String
        total Decimal
      event OrderRenamed
        orderRef String
        label String
      event OrderTouched
        label String
      readmodel OrderView
        orderId String
        label String
        region String
        total Decimal
      query OrderViewById => OrderView?
        by orderId String
      projection Orders => OrderView
        no automap
        from OrderPlaced key orderId, OrderRenamed key orderRef, OrderTouched
          label = label
