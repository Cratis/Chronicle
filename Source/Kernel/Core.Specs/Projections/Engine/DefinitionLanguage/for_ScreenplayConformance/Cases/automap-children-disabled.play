// no automap on a child collection while the projection maps automatically
// Screenplay documentation: Documentation/screenplay/projections/auto-map.mdx

type OrderLine
  lineNumber Int
  sku String
module Conformance
  feature Cases
    slice StateView Case
      event LineAdded
        orderId String
        lineNumber Int
        sku String
        quantity Int
      event LineChanged
        orderId String
        lineNumber Int
        sku String
      event LineRemoved
        orderId String
        lineNumber Int
      event ProductDiscontinued
        sku String
      event ProductRenamed
        sku String
        title String
      readmodel OrderView
        orderId String
        lines OrderLine[]
      query OrderViewById => OrderView?
        by orderId String
      projection Orders => OrderView
        children lines identified by lineNumber
          no automap
          from LineAdded key lineNumber
            parent orderId
            sku = sku
