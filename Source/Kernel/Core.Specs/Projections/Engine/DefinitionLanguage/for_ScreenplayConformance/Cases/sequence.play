// A projection observing a named event sequence
// Screenplay documentation: Documentation/screenplay/projections/grammar.md

module Conformance
  feature Cases
    slice StateView Case
      event OrderPlaced
        orderId String
        label String
        region String
        total Decimal
      event OrderRenamed
        orderRef String
        label String
      event OrderTouched
        label String
      readmodel OrderView
        orderId String
        label String
        region String
        total Decimal
      query OrderViewById => OrderView?
        by orderId String
      projection Orders => OrderView
        no automap
        sequence outbox
        from OrderPlaced
          label = label
