// remove with keyed by an event property deletes the instance
// Screenplay documentation: Documentation/screenplay/projections/removal.md

module Conformance
  feature Cases
    slice StateView Case
      event OrderPlaced
        orderId String
        label String
      event OrderCancelled
        orderId String
      readmodel OrderView
        orderId String
        label String
      query OrderViewById => OrderView?
        by orderId String
      projection Orders => OrderView
        no automap
        from OrderPlaced key orderId
          label = label
        remove with OrderCancelled key orderId
