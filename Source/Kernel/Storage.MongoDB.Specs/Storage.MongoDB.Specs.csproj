<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Chronicle.Storage.MongoDB.Specs</AssemblyName>
        <RootNamespace>Cratis.Chronicle.Storage.MongoDB</RootNamespace>
        <IsTestProject>true</IsTestProject>
        <!-- Referenced by the xUnit v2 Integration projects, so this spec family stays on xUnit v2. -->
        <UseXunitV2>true</UseXunitV2>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../Core.Specs/Compliance/given/protected_values.cs" Link="Compliance/given/protected_values.cs" />
        <PackageReference Include="Cratis.Arc" />
        <PackageReference Include="Testcontainers" />
        <!-- Pulls Testcontainers' vulnerable SSH.NET forward — see Directory.Packages.props. -->
        <PackageReference Include="SSH.NET" />
        <ProjectReference Include="../Storage.MongoDB/Storage.MongoDB.csproj" />
        <ProjectReference Include="../Storage.InMemory/Storage.InMemory.csproj" />
        <ProjectReference Include="../Storage/Storage.csproj" />
        <ProjectReference Include="../Concepts/Concepts.csproj" />
        <!-- AddChronicleToSilo (Cratis.Chronicle.Setup) now lives in the Grpc assembly, not Core -
             see Source/Kernel/Grpc/Grpc.csproj. -->
        <ProjectReference Include="../Grpc/Grpc.csproj" />
        <!-- The shared ISink contract specifications live here and run against this implementation. -->
        <ProjectReference Include="../Storage.Specs/Storage.Specs.csproj" />
    </ItemGroup>
    <ItemGroup>
    </ItemGroup>
</Project>
