<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Chronicle.Storage.Sql</AssemblyName>
        <RootNamespace>Cratis.Chronicle.Storage.Sql</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Cratis.Chronicle.Storage.Sql.Specs" />
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2" Key="" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.Metrics.Roslyn" />
        <PackageReference Include="Microsoft.Orleans.Reminders" />
        <PackageReference Include="Cratis.Orleans.Storage.Sql" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Core/Core.csproj" />
        <ProjectReference Include="../Storage/Storage.csproj" />
        <ProjectReference Include="../Concepts/Concepts.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Cratis.Arc" />
      <PackageReference Include="Cratis.Arc.EntityFrameworkCore" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
      <!-- Override the vulnerable native SQLite library (GHSA-2m69-gcr7-jv3q) pulled in transitively by EF Core Sqlite. -->
      <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
      <PackageReference Include="Microsoft.Data.SqlClient" />
      <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" />
      <PackageReference Include="Microsoft.Identity.Client.NativeInterop" ExcludeAssets="native" />
      <!-- Override the vulnerable System.Security.Cryptography.Pkcs 9.0.18 pulled in transitively by Microsoft.Data.SqlClient. -->
      <PackageReference Include="System.Security.Cryptography.Pkcs" />
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
      <PackageReference Include="Azure.Identity" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    </ItemGroup>
</Project>
