<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Chronicle.Grpc</AssemblyName>
        <RootNamespace>Cratis.Chronicle.Services</RootNamespace>
        <!-- CS8601 is the generator's own pre-existing gap in Users.cs/Applications.cs (predates this move -
             see PLAN2.md Phase 0), not something this project introduces. It only surfaces as a build failure
             here because Release treats warnings as errors (Source/Directory.Build.props) and nobody had
             verified a Release build of the code that carried it before. Fixing it for real means teaching
             GrpcCodeGenerator to emit a null-safe assignment, which is generator work out of this phase's
             scope - suppress it here rather than hand-edit generated output that the next build overwrites. -->
        <NoWarn>$(NoWarn);ORLEANS0010;CS8618;MA0182;CS8601</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Cratis.Chronicle.Server" />
        <InternalsVisibleTo Include="Cratis.Chronicle.Core.Specs" />
        <!-- Cratis.Chronicle.Testing's in-process *Scenario helpers wrap these service implementations
             directly, and Cratis.Chronicle.XUnit.Integration constructs ConnectionService directly - both
             already had this access via Core.csproj's InternalsVisibleTo before the classes moved here. -->
        <InternalsVisibleTo Include="Cratis.Chronicle.Testing" />
        <InternalsVisibleTo Include="Cratis.Chronicle.XUnit.Integration" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Core/Core.csproj" />
        <ProjectReference Include="../Contracts/Contracts.csproj" />
        <!-- Core.csproj marks its own references to these two PrivateAssets="all", so they do not flow
             transitively through the Core.csproj reference above - the moved gRPC boundary code (converters,
             ChronicleServerSiloBuilderExtensions) needs both directly. -->
        <ProjectReference Include="../Concepts/Concepts.csproj" />
        <ProjectReference Include="../../Clients/Connections/Connections.csproj" />
    </ItemGroup>
</Project>
