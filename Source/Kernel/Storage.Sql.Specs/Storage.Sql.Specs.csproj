        <PackageReference Include="SSH.NET" />
        <ProjectReference Include="../Storage.Sql/Storage.Sql.csproj" />
        <ProjectReference Include="../Concepts/Concepts.csproj" />
        <!-- The shared ISink contract specifications live here and run against this implementation. -->
        <ProjectReference Include="../Storage.Specs/Storage.Specs.csproj" />
    </ItemGroup>
</Project>
