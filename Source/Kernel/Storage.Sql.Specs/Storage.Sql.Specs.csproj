<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Chronicle.Storage.Sql.Specs</AssemblyName>
        <RootNamespace>Cratis.Chronicle.Storage.Sql</RootNamespace>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
        <CratisSpecificationsSharedLifecycle>false</CratisSpecificationsSharedLifecycle>
        <CratisSpecificationsReadableNames>false</CratisSpecificationsReadableNames>
        <IsPackable>false</IsPackable>
        <!-- Microsoft.Data.SqlClient cannot connect in globalization-invariant mode. -->
        <InvariantGlobalization>false</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../Core.Specs/Compliance/given/protected_values.cs" Link="Compliance/given/protected_values.cs" />
        <ProjectReference Include="../Core/Core.csproj" />
        <PackageReference Include="Testcontainers" />
        <Compile Include="../../../Integration/Client/SqlServerContainerImage.cs" Link="SqlServerContainerImage.cs" />
        <Compile Include="../../../Integration/Client/ContainerStartup.cs" Link="ContainerStartup.cs" />
        <Compile Include="../../../Integration/Client/ContainerStartupAttempt.cs" Link="ContainerStartupAttempt.cs" />
        <Compile Include="../../../Integration/Client/ContainerStartupFailed.cs" Link="ContainerStartupFailed.cs" />
        <Compile Include="../../../Integration/Client/ContainerExit.cs" Link="ContainerExit.cs" />
        <Compile Include="../../../Integration/Client/DockerContainerEvidence.cs" Link="DockerContainerEvidence.cs" />
        <PackageReference Include="SSH.NET" />
        <ProjectReference Include="../Storage.Sql/Storage.Sql.csproj" />
        <ProjectReference Include="../Storage.Specs/Storage.Specs.csproj" />
        <ProjectReference Include="../Concepts/Concepts.csproj" />
        <!-- The shared ISink contract specifications live here and run against this implementation. -->
        <ProjectReference Include="../Storage.Specs/Storage.Specs.csproj" />
    </ItemGroup>
</Project>
