<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Chronicle.Compatibility.Specs</AssemblyName>
        <RootNamespace>Cratis.Chronicle.Compatibility</RootNamespace>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);SA1600</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Compatibility/Compatibility.csproj" />
        <ProjectReference Include="../Contracts/Contracts.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Direct pin: Cratis.Arc.MongoDB floats Castle.Core to 5.2.1, whose proxy mapping regression breaks NSubstitute class proxies. -->
        <PackageReference Include="Castle.Core" />
    </ItemGroup>
</Project>
