<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Dotnet" />
    <PackageReference Include="Aspire.Hosting.Yarp" />
  </ItemGroup>

  <!-- Build ordering only: the AppHost launches these projects by path, it does not reference their assemblies. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Source\Kernel\Server\Server.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\AspNetCore\AspNetCore.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
