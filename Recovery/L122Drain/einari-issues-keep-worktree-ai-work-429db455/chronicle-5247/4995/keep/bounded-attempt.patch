+        builder.AddInterceptors(configuredInterceptors);
+        if (configuredInterceptors.Any(interceptor => interceptor is ISingletonInterceptor))
+        {
+            // Fresh singleton interceptors such as SqlReadCapture vary EF's provider cache key per spec.
+            builder.EnableServiceProviderCaching(false);
+        }
         return builder;
     }
