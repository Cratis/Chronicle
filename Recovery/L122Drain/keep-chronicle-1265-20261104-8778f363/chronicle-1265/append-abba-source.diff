+
+namespace Cratis.Chronicle.Clients.for_ClientConnection.when_connecting;
+
+public class after_disconnect : given.a_client_connection
+{
+    ClientConnectionEpoch _firstEpoch;
+    ClientConnectionEpoch _secondEpoch;
