diff --git a/Source/Kernel/Core.Specs/Clients/for_ConnectedClients/when_client_connects_and_the_client_connection_fails.cs b/Source/Kernel/Core.Specs/Clients/for_ConnectedClients/when_client_connects_and_the_client_connection_fails.cs
