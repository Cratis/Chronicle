@@ -12,6 +13,38 @@ namespace Cratis.Chronicle.Observation;
 /// </summary>
 internal static partial class ClientObserverSubscriberLogging
 {
+    /// <summary>
+    /// Logs one summary when a batch failed, leaving the subscriber result unchanged.
+    /// </summary>
+    /// <param name="result">The completed delivery result.</param>
+    /// <param name="logger">The subscriber logger.</param>
+    /// <param name="observerId">The observer handling the batch.</param>
+    /// <param name="events">The delivered events.</param>
+    /// <returns>The original delivery result.</returns>
+    internal static ObserverSubscriberResult WithBatchFailureLogged(this ObserverSubscriberResult result, ILogger logger, ObserverId observerId, IEnumerable<AppendedEvent> events)
+    {
+        if (result.State != ObserverSubscriberState.Failed) return result;
+
+        var batch = events as AppendedEvent[] ?? events.ToArray();
+        if (batch.Length > 0)
+        {
+            logger.BatchFailed(observerId, batch.Length, batch[0].Context.EventType.Id, batch[0].Context.SequenceNumber, batch[^1].Context.SequenceNumber);
+        }
+        return result;
+    }
+
+    /// <summary>
+    /// Logs a failed batch without logging individual events or exception details.
+    /// </summary>
+    /// <param name="logger">The subscriber logger.</param>
+    /// <param name="observerId">The observer handling the batch.</param>
+    /// <param name="count">The number of delivered events.</param>
+    /// <param name="firstEventTypeId">The type of the first event.</param>
+    /// <param name="firstSequenceNumber">The start of the delivered range.</param>
+    /// <param name="lastSequenceNumber">The end of the delivered range.</param>
+    [LoggerMessage(LogLevel.Warning, "Observer {ObserverId} failed batch of {Count} events, first type {FirstEventTypeId}, sequence range {FirstSequenceNumber}-{LastSequenceNumber}")]
+    internal static partial void BatchFailed(this ILogger logger, ObserverId observerId, int count, EventTypeId firstEventTypeId, EventSequenceNumber firstSequenceNumber, EventSequenceNumber lastSequenceNumber);
+
     [LoggerMessage(LogLevel.Warning, "Delivery expired before dispatch for {Observer} partition {Partition}")]
     internal static partial void DeliveryExpiredBeforeDispatch(this ILogger logger, ObserverKey observer, Key partition);
 
