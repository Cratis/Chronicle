<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Chronicle.Benchmarks.Kernel</AssemblyName>
    <RootNamespace>Cratis.Chronicle.Benchmarks.Kernel</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The client stream benchmark declares a code-first gRPC probe; PBN3013 asks for a [ProtoModel] the pinned protobuf-net.Grpc runtime cannot use. -->
    <NoWarn>$(NoWarn);PBN3013</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Cratis.Choreography" />
    <PackageReference Include="Cratis.Choreography.Storage" />
    <PackageReference Include="Cratis.Fundamentals" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Source/Kernel/Core/Core.csproj" />
    <ProjectReference Include="../../Source/Kernel/Concepts/Concepts.csproj" />
    <ProjectReference Include="../../Source/Kernel/Grpc/Grpc.csproj" />
    <ProjectReference Include="../../Source/Kernel/Storage.InMemory/Storage.InMemory.csproj" />
  </ItemGroup>
</Project>
