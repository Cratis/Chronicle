<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DisableProxyGenerator>true</DisableProxyGenerator>
    <LocalImageName>$(CRATIS_CHRONICLE_LOCAL_IMAGE)</LocalImageName>
    <LocalImageName Condition="'$(LocalImageName)' == ''">cratis/chronicle:local-development</LocalImageName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Testcontainers" />
  </ItemGroup>

  <ItemGroup>
    <!-- The client is referenced directly rather than picked up through the server: the server reference is
         dropped when ArtifactsPath is set, which is how BenchmarkDotNet rebuilds this project before running,
         and every benchmark here uses the client API. -->
    <ProjectReference Include="../../Source/Clients/DotNET/DotNET.csproj" />
    <ProjectReference Include="../../Source/Clients/Connections/Connections.csproj" />
    <ProjectReference Include="../../Source/Infrastructure/Infrastructure.csproj" />
    <ProjectReference Include="../../Source/Kernel/Server/Server.csproj" Condition="'$(ArtifactsPath)' == ''" />
  </ItemGroup>

  <!-- The image runs Linux, so on macOS the kernel is published for the Linux runtime identifier of the
       container. A plain build would copy a macOS apphost into the image, and the container would fail to start
       with "Exec format error". On Linux the default runtime identifier already matches the container. -->
  <PropertyGroup Condition="'$(DisableDockerBuild)' != 'true'">
    <_IsOSX>$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))</_IsOSX>
    <_DockerPublishRid Condition="'$(_IsOSX)' == 'True' And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'">linux-arm64</_DockerPublishRid>
    <_DockerPublishRid Condition="'$(_IsOSX)' == 'True' And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64'">linux-x64</_DockerPublishRid>
  </PropertyGroup>

  <Target Name="BuildDocker" AfterTargets="Build" Condition="'$(DisableDockerBuild)' != 'true' and '$(ArtifactsPath)' == ''">
    <!-- Publishes the kernel in Debug with the DEVELOPMENT symbol, so dev credentials are seeded, through the
         same shared target the integration projects use, which wipes Source/Kernel/Server/out before publishing. -->
    <MSBuild Projects="$(MSBuildThisFileDirectory)../../Integration/LocalKernelPublish.proj" Targets="PublishKernel" Properties="KernelPublishRid=$(_DockerPublishRid)" />
    <Exec Command="docker build -t $(LocalImageName) -f Docker/Local/Dockerfile ." WorkingDirectory="$(MSBuildThisFileDirectory)../../" />
  </Target>

</Project>
