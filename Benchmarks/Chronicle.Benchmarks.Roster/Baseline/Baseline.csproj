<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <BaselineRevision Condition="'$(BaselineRevision)' == ''">a5e06dbf0e</BaselineRevision>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Source/Kernel/Core/Core.csproj" />
    <ProjectReference Include="../../../Source/Kernel/Concepts/Concepts.csproj" />
    <Compile Include="../../../Source/Kernel/GlobalUsings.cs" Link="GlobalUsings.cs" />
    <Compile Include="$(IntermediateOutputPath)AdministratorRoster.cs" />
    <Compile Include="$(IntermediateOutputPath)AdministratorRosterLogging.cs" />
  </ItemGroup>
  <Target Name="ExtractCachedBaseline" BeforeTargets="CoreCompile">
    <Exec WorkingDirectory="$(MSBuildThisFileDirectory)" Command="node &quot;$(MSBuildThisFileDirectory)extract-baseline.mjs&quot; &quot;$(BaselineRevision)&quot; &quot;$(IntermediateOutputPath)&quot;" />
  </Target>
</Project>
