<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Cratis.Chronicle.Benchmarks.Clustering</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Match Source's Specifications 5 settings: type-discovery experimental types, incremental cancellation-token adoption, original display names. -->
    <NoWarn>$(NoWarn);CRSPECEXP01;xUnit1051</NoWarn>
    <CratisSpecificationsReadableNames>false</CratisSpecificationsReadableNames>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Cratis.Specifications.XUnit.v3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <Compile Include="../Chronicle.Benchmarks.Clustering/RebuildBaselineProbe.cs" Link="RebuildBaselineProbe.cs" />
    <Compile Include="../Chronicle.Benchmarks.Clustering/RebuildBaselineMath.cs" Link="RebuildBaselineMath.cs" />
    <Compile Include="../Chronicle.Benchmarks.Clustering/RebuildBaselineComparison.cs" Link="RebuildBaselineComparison.cs" />
    <Compile Include="../Chronicle.Benchmarks.Clustering/RebuildBaselineSettings.cs" Link="RebuildBaselineSettings.cs" />
    <Compile Include="../Chronicle.Benchmarks.Clustering/ClusterTopology.cs" Link="ClusterTopology.cs" />
    <Compile Include="../Chronicle.Benchmarks.Clustering/ClusterRoleAssignment.cs" Link="ClusterRoleAssignment.cs" />
    <Compile Include="../Chronicle.Benchmarks.Clustering/RebuildBaselineActivations.cs" Link="RebuildBaselineActivations.cs" />
  </ItemGroup>
</Project>
