<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Cratis.Chronicle.Chaos</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CRSPECEXP01;xUnit1051</NoWarn>
    <CratisSpecificationsReadableNames>false</CratisSpecificationsReadableNames>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Cratis.Specifications.XUnit.v3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <ProjectReference Include="../ChaosRig/ChaosRig.csproj" AdditionalProperties="DisableDockerBuild=true" />
  </ItemGroup>
</Project>
