<?xml version="1.0" encoding="UTF-8" ?>
<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <AssemblyName>Cratis.Chronicle.Kernel.Integration</AssemblyName>
        <RootNamespace>Cratis.Chronicle.Kernel.Integration</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../Source/Clients/AspNetCore/AspNetCore.csproj" />
        <ProjectReference Include="../../Source/Clients/Connections/Connections.csproj" />

        <ProjectReference Include="../../Source/Kernel/Storage.MongoDB/Storage.MongoDB.csproj" />
        <ProjectReference Include="../../Source/Kernel/Storage.Sql/Storage.Sql.csproj" />
        <ProjectReference Include="../Clustering/Clustering.csproj" />
        <ProjectReference Include="../../Source/Kernel/Concepts/Concepts.csproj" />
        <ProjectReference Include="../../Source/Kernel/Contracts/Contracts.csproj" />
        <!-- Also exposed under the explicit KernelCore alias (alongside the default "global" alias
             most of this project already relies on) because Cratis.Chronicle.Core and the
             Cratis.Chronicle client (pulled in via AspNetCore.csproj) both declare
             EventSequences.AppendOutcome / IdempotencyConflictReason; files that need the kernel's
             own version disambiguate with "extern alias KernelCore;". -->
        <ProjectReference Include="../../Source/Kernel/Core/Core.csproj">
            <Aliases>KernelCore,global</Aliases>
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Cratis.Arc.Core" />
        <PackageReference Include="Cratis.Arc.MongoDB" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
        <PackageReference Include="Microsoft.Orleans.TestingHost" />
        <PackageReference Include="Testcontainers.PostgreSql" />
        <PackageReference Include="OneOf" />
        <PackageReference Include="Microsoft.Orleans.Sdk" />
    </ItemGroup>
    <ItemGroup>
        <!-- Direct pin: Cratis.Arc.MongoDB floats Castle.Core to 5.2.1, whose proxy mapping regression breaks NSubstitute class proxies. -->
        <PackageReference Include="Castle.Core" />
    </ItemGroup>
</Project>
